# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: Required. Connection string for the MongoDB database that stores
# user accounts, password hashes, OTPs, and password-reset tokens.
# Local example: mongodb://127.0.0.1:27017/fluenxia
# Atlas example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/fluenxia
MONGODB_URI=

# JWT_SECRET: Required. Signs and verifies login session tokens.
# Use a long, random, unguessable string (e.g. `openssl rand -hex 32`). Never commit the real value.
JWT_SECRET=

# ALLOW_DEV_AUTH: Optional, defaults to disabled. Set to "true" only in local development to
# re-enable convenience shortcuts that skip real credential checks (direct Google/Apple sign-in
# without OAuth, the admin passcode endpoint, OTP/password master codes, and OTP codes echoed back
# in API responses). Leave unset (or "false") in any environment real users can reach.
ALLOW_DEV_AUTH=

# OWNER_EMAIL / OWNER_PASSWORD: Required once, on first production boot only. When the database has
# zero users, the server creates exactly one real owner account from these two values (password gets
# hashed before storage) and does not touch them again afterwards. No demo/default account is ever
# created automatically — leave these unset only if you're seeding local demo data with `npm run seed:demo`
# instead. Safe to remove from your deployment's env after the first successful boot.
OWNER_EMAIL=
OWNER_PASSWORD=

# APP_URL: The backend's own public URL (this server, e.g. your Render service URL).
# Used to build the Google OAuth redirect_uri — must always point at THIS backend, never at the
# frontend's URL, since the /auth/google/callback route only exists here.
# Single-deploy example: the same URL this server runs at.
# Split-deploy example (backend on Render, frontend on Vercel): the Render URL, e.g.
#   https://fluenxia-backend.onrender.com
APP_URL="MY_APP_URL"

# FRONTEND_ORIGIN: Only needed when the frontend is deployed separately from this backend
# (e.g. frontend on Vercel, this backend on Render). Set it to the frontend's exact origin
# (e.g. https://fluenxia.vercel.app) so CORS allows the browser to call this API cross-origin.
# Leave unset for a single combined deployment (this server serving both frontend and API).
FRONTEND_ORIGIN=

# Google Authentication / OAuth 2.0 Credentials (for Student & Admin Google Sign-In)
# Obtain these from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Authorized redirect URI: ${APP_URL}/auth/google/callback
# Required for Google Sign-In to work at all once ALLOW_DEV_AUTH is off (the default) — without
# these, the real OAuth popup flow has nothing to authenticate against and Google Sign-In will fail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: SMTP Configuration for sending actual live OTP emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LinguaFlow LMS <no-reply@linguaflow.com>"
